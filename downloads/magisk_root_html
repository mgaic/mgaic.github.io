  --bg-color-model: rgba(0, 0, 0, 0.05);
  /* 文字颜色 */
  --color-text-primary: #1c1c28;
  --color-text-content: #555570;
  --color-text: #555570;
  --color-text-desc: #8f8fa6;
  /* 主要按钮背景色 */
  --primary-btn-color: #6d5ffd;
  --primary-btn-linear-gradient: linear-gradient(141deg, #e2b1ff 5.23%, #6e60fd 97.15%);
  /* 热门问题背景色 */
  --hot-question-item-bg: #fff;
  /* 弹窗背景色 */
  --van-c-popup-bg: #fff;
  /* 消息背景色 */
  --color-message-bg-left: #fff;
  --color-message-bg-right: linear-gradient(90deg, #a391ff 0%, #7782ff 100%);
  --color-message-bg-code: #1a1a23;
  --color-message-bg-card-bottom: #e8e8f0;
  --color-message-pager-text: #555666;
  --color-message-pager-text-disable: #999aaa;
  --color-message-reference-bg: rgba(109, 95, 253, 0.1);
  --color-message-reference-em-bg: #555570;
  --color-message-reference-em-text: #fff;
  --color-message-reference-text: #555666;
  /* 反馈 */
  --feedback-icon-color: #555666;
  --feedback-bg-color: rgba(0, 0, 0, 0.05);
  /* sug */
  --color-sug-bg: #fff;
  --color-sug-active-bg: #f6f7fb;
  /* 相关问题 */
  --questions-color-text: #555666;
  --questions-color-border: #ccccd8;
  --questions-color-bg: #fff;
  /* 输入框 */
  --color-input-bg: #fff;
  --color-input-border: #e8e8f0;
  --color-input-tip: #ccccd8;
  /* 角色扮演、角色指令 */
  --color-role-card-bg: #fff;
  --color-role-card-border: #f2f2f5;

  --color-skeleton-background: rgba(0, 0, 0, 0.05);
  .van-popup {
    background-color: var(--van-c-popup-bg);
  }
}

