/* wap */
#chat-search-component {
  /* 全局底色和渐变色 */
  --bg-color: #ffffff;
  --bg-color-gradient: linear-gradient(
    180deg,
    rgba(225, 226, 246, 0.4) 0%,
    rgba(245, 231, 254, 0.4) 100%
  );
